# ==============================================================================
# Aayush Sharma Portfolio — Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# [SERVER-ONLY] Server Port & Environment Mode
PORT=5000
NODE_ENV=development

# [SERVER-ONLY / PRIVATE] MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.ohccmuj.mongodb.net/portfolio_db?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb://localhost:27017/portfolio_db
MONGODB_URI=mongodb://localhost:27017/portfolio_db

# [SERVER-ONLY / PUBLIC-CONFIG] Frontend Allowed Origins (Comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# [SERVER-ONLY / PRIVATE] Authentication & Admin Secret Key
# Used to verify administrative access to /api/admin/* dashboard endpoints
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ADMIN_SECRET=your_secure_admin_passcode_here

# [SERVER-ONLY / PRIVATE] Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
